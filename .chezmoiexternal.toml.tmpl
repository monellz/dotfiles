{{ if eq .kind "server" -}}
{{- /*
  服务器上通常没有 root，系统自带的版本也常常太旧（fzf --zsh 要 0.48 以上），
  所以 shell 配置里用到的命令行工具直接下载官方预编译程序放到 ~/.local/bin。
  版本固定写在这里，升级时改版本号。
  .chezmoi.arch 是 amd64 / arm64：fzf 的文件名直接用它，其余几个用 x86_64 / aarch64。
*/ -}}
{{- $fzf := "0.74.5" -}}
{{- $zoxide := "0.10.0" -}}
{{- $starship := "1.27.0" -}}
{{- $yazi := "26.9.1" -}}
{{- $fd := "10.5.0" -}}
{{- $rg := "15.2.0" -}}
{{- $dust := "1.2.7" -}}
{{- $clangd := "22.1.1" -}}
{{- $arch := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch -}}
[".local/bin/fzf"]
    type = "archive-file"
    url = "https://github.com/junegunn/fzf/releases/download/v{{ $fzf }}/fzf-{{ $fzf }}-linux_{{ .chezmoi.arch }}.tar.gz"
    path = "fzf"
    executable = true

# musl 版本是静态链接的，不依赖服务器上的 glibc 版本
[".local/bin/zoxide"]
    type = "archive-file"
    url = "https://github.com/ajeetdsouza/zoxide/releases/download/v{{ $zoxide }}/zoxide-{{ $zoxide }}-{{ $arch }}-unknown-linux-musl.tar.gz"
    path = "zoxide"
    executable = true

[".local/bin/starship"]
    type = "archive-file"
    url = "https://github.com/starship/starship/releases/download/v{{ $starship }}/starship-{{ $arch }}-unknown-linux-musl.tar.gz"
    path = "starship"
    executable = true

# yazi 的压缩包里程序在 yazi-<架构>-unknown-linux-musl/ 目录下；ya 是它的插件和主题管理命令
[".local/bin/yazi"]
    type = "archive-file"
    url = "https://github.com/sxyazi/yazi/releases/download/v{{ $yazi }}/yazi-{{ $arch }}-unknown-linux-musl.zip"
    path = "yazi-{{ $arch }}-unknown-linux-musl/yazi"
    executable = true

[".local/bin/ya"]
    type = "archive-file"
    url = "https://github.com/sxyazi/yazi/releases/download/v{{ $yazi }}/yazi-{{ $arch }}-unknown-linux-musl.zip"
    path = "yazi-{{ $arch }}-unknown-linux-musl/ya"
    executable = true

# 按文件名查找（更好用的 find），yazi 里按 s 搜索也用它
[".local/bin/fd"]
    type = "archive-file"
    url = "https://github.com/sharkdp/fd/releases/download/v{{ $fd }}/fd-v{{ $fd }}-{{ $arch }}-unknown-linux-musl.tar.gz"
    path = "fd-v{{ $fd }}-{{ $arch }}-unknown-linux-musl/fd"
    executable = true

# 按内容搜索（更快的 grep -r），yazi 里按 S 搜索也用它。ripgrep 的版本标签不带 v
[".local/bin/rg"]
    type = "archive-file"
    url = "https://github.com/BurntSushi/ripgrep/releases/download/{{ $rg }}/ripgrep-{{ $rg }}-{{ $arch }}-unknown-linux-musl.tar.gz"
    path = "ripgrep-{{ $rg }}-{{ $arch }}-unknown-linux-musl/rg"
    executable = true

# 查看目录占用的磁盘空间（更好用的 du）
[".local/bin/dust"]
    type = "archive-file"
    url = "https://github.com/bootandy/dust/releases/download/v{{ $dust }}/dust-v{{ $dust }}-{{ $arch }}-unknown-linux-musl.tar.gz"
    path = "dust-v{{ $dust }}-{{ $arch }}-unknown-linux-musl/dust"
    executable = true


{{- if eq .chezmoi.arch "arm64" }}

# C/C++ 语言服务器。mason 没有 arm64 Linux 的 clangd，官方 Release 也没有，
# 这里用 PyPI 的 wheel（就是 zip 包）；其他平台由 mason 安装。
# 它要用同目录 lib/clang 下的内置头文件，所以解压整个目录，~/.local/bin 里放符号链接。
[".local/opt/clangd"]
    type = "archive"
    url = "https://files.pythonhosted.org/packages/py2.py3/c/clangd/clangd-{{ $clangd }}-py2.py3-none-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl"
    format = "zip"
    stripComponents = 2
    exact = true
{{- end }}
{{- end }}





{{- /* 这一项所有机器都装，所以放在 server 判断外面 */}}
{{- $treeSitter := get (dict
  "linux/amd64" "linux-64/tree-sitter-cli-0.27.1-hc7555a6_0"
  "linux/arm64" "linux-aarch64/tree-sitter-cli-0.27.1-h4f14f73_0"
  "darwin/amd64" "osx-64/tree-sitter-cli-0.27.1-hb042fba_0"
  "darwin/arm64" "osx-arm64/tree-sitter-cli-0.27.1-haee3d69_0"
) (printf "%s/%s" .chezmoi.os .chezmoi.arch) }}

# 解析代码做语法高亮，nvim-treesitter 编译 parser 时要用。
# 官方程序要 glibc 2.39，conda-forge 的构建只要 2.17。.conda 是 zip 里套 tar.zst，用 python 取出内层包
[".local/bin/tree-sitter"]
    type = "archive-file"
    url = "https://conda.anaconda.org/conda-forge/{{ $treeSitter }}.conda"
    format = "tar.zst"
    path = "bin/tree-sitter"
    executable = true
    [".local/bin/tree-sitter".filter]
        command = "python3"
        args = ["-Ic", "import io,sys,zipfile; z=zipfile.ZipFile(io.BytesIO(sys.stdin.buffer.read())); sys.stdout.buffer.write(z.read(next(n for n in z.namelist() if n.startswith('pkg-'))))"]





